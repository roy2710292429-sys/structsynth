# Chat completion provider
QS_LLM_BASE_URL=https://api.deepseek.com
QS_LLM_API_KEY=replace-with-deepseek-key
QS_CHAT_MODEL=deepseek-flash

# Embedding provider; it must implement POST /embeddings
QS_EMBEDDING_BASE_URL=https://api.openai.com/v1
QS_EMBEDDING_API_KEY=replace-with-embedding-key
QS_EMBEDDING_MODEL=text-embedding-3-small

QS_LLM_TIMEOUT=120
